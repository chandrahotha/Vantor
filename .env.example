# Each organization copies this to `.env` (never commit `.env`).
# All defaults are free/self-host compatible. No paid SaaS required for local dev.

# --- Core ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
TENANT_DEFAULT_SLUG=demo

# --- Postgres (primary + pgvector) ---
POSTGRES_USER=vantor
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=vantor
DATABASE_URL=postgresql://vantor:change-me-in-env@postgres:5432/vantor

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO, S3-compatible, free) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vantor-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-change-me

# --- Auth (Keycloak, self-host OIDC, free) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=vantor
KEYCLOAK_CLIENT_ID=vantor-web
KEYCLOAK_CLIENT_SECRET=change-me
OIDC_ISSUER=http://keycloak:8080/realms/vantor
JWT_AUDIENCE=vantor-web

# --- AI gateway (free-first; BYO keys, never commit real keys) ---
# Provider options: ollama | openrouter-free | groq-free | huggingface | disabled
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Optional free-tier cloud fallbacks (BYO key):
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=meta-llama/llama-3.1-8b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=
AI_MAX_TOKENS=2000
AI_REQUIRE_EVIDENCE=true
AI_REQUIRE_HUMAN_REVIEW_DEFAULT=true

# --- Document pipeline ---
OCR_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXT=pdf,docx,xlsx,csv,png,jpg,jpeg,tiff

# --- Observability ---
LOG_LEVEL=info
OTEL_ENABLED=false

# --- Secrets (generate per env; never use defaults in prod) ---
JWT_SECRET=generate-32-bytes-min
REFRESH_TOKEN_SECRET=generate-32-bytes-min
ENCRYPTION_KEY=generate-32-bytes-min
