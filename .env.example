# Each organization copies this to `.env` (never commit `.env`).
# All defaults are free/self-host compatible. No paid SaaS required for local dev.

# --- Core ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Public web origin (baked into the Next.js build for sitemap/robots/OG).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=vantor
NEXT_PUBLIC_KEYCLOAK_CLIENT=vantor-web
TENANT_DEFAULT_SLUG=demo

# --- Postgres (primary + pgvector) ---
POSTGRES_USER=vantor
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=vantor
DATABASE_URL=postgresql://vantor:change-me-in-env@postgres:5432/vantor

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO, S3-compatible, free) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vantor-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-change-me

# --- Auth (Keycloak, self-host OIDC, free) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=vantor
KEYCLOAK_CLIENT_ID=vantor-web
KEYCLOAK_CLIENT_SECRET=change-me
OIDC_ISSUER=http://keycloak:8080/realms/vantor
JWT_AUDIENCE=vantor-web

# --- AI gateway (free-first; BYO keys, never commit real keys) ---
# Provider options: disabled | ollama | opencode | openrouter | opencode-zen |
#                   omnirouter | nvidia | openai | anthropic | gemini
#
# Defaults to `disabled` — the deterministic mode. It answers UNKNOWN with
# confidence 0.0 and never fabricates an answer, which is the honest state for a
# fresh clone. Pick a provider below to switch it on.
#   local:  docker compose --profile ai up -d ollama   then  AI_PROVIDER=ollama
#   online: paste a free key (OpenRouter / NVIDIA / OpenCode Zen) and set its name.
AI_PROVIDER=disabled
# Leave empty to use each provider's own default model.
AI_DEFAULT_MODEL=
# Leave empty for the built-in Vantor voice (plain, no filler, says what it
# would check next). Set it to pin a house style for every provider.
AI_SYSTEM_PROMPT=

# Self-hosted. Ollama needs `--profile ai`; it is not in the default stack.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=

# Free online endpoints — bring your own key. Set one and switch AI_PROVIDER to
# its name. OpenRouter and OpenCode Zen both have genuinely free tiers.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=gpt-5-nano
OPENCODE_ZEN_API_KEY=
OMNIROUTER_BASE_URL=
OMNIROUTER_MODEL=
OMNIROUTER_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_API_KEY=

# Paid BYOK — same contract, your key and your bill.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

AI_MAX_TOKENS=2000
AI_REQUIRE_EVIDENCE=true
AI_REQUIRE_HUMAN_REVIEW_DEFAULT=true

# --- Document pipeline ---
OCR_ENABLED=true
# disabled (default, keyword search only) | toy (deterministic offline vectors,
# labelled `toy-rank` so nobody mistakes it for meaning) | ollama (real vectors,
# needs `--profile ai`).
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=nomic-embed-text
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXT=pdf,docx,xlsx,csv,png,jpg,jpeg,tiff
UPLOAD_DIR=uploads

# --- Worker (RQ service calls; provision via Keycloak client-credentials) ---
# Create a Keycloak service account with a manager-level role and put its token here.
SERVICE_API_TOKEN=

# --- Rate limiting (per tenant; Redis; fail-open when Redis is down) ---
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_READ_PER_MIN=600

# --- Observability ---
LOG_LEVEL=info
OTEL_ENABLED=false

# --- Secrets (generate per env; never use defaults in prod) ---
JWT_SECRET=generate-32-bytes-min
REFRESH_TOKEN_SECRET=generate-32-bytes-min
ENCRYPTION_KEY=generate-32-bytes-min
