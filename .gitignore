# `pytest --cov` writes this at the repo root; it is a local run artifact, not source.
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/
.pytest_cache/
# Throwaway SQLite files from ad-hoc probes and smoke runs. `DATABASE_URL` is a
# single environment variable, so a hand-typed `sqlite:///./_probe.db` writes
# into the repo; these are run artifacts, never source.
backend/_*.db
*.db-journal

# Kilo worktrees and local editor cache
.kilo/

# Next.js auto-generated agent prompt rules
frontend/AGENTS.md
frontend/CLAUDE.md
