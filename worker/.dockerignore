# Build context for `worker/Dockerfile`.
#
# The Dockerfile copies named paths only — `requirements.txt`, `jobs.py`,
# `worker.py`, `enqueue.py`, `beat.py` — so host files cannot overwrite the
# image's contents here. This file keeps the context itself small.
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.venv
tests

# Local environment files and private keys. The Dockerfile copies named paths
# only, so these would not reach the image — but they have no business being
# in the build context either.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
