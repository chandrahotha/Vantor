# Build context for `worker/Dockerfile`.
#
# The Dockerfile copies named paths only — `requirements.txt`, `jobs.py`,
# `worker.py`, `enqueue.py`, `beat.py` — so host files cannot overwrite the
# image's contents here. This file keeps the context itself small.
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.venv
tests
